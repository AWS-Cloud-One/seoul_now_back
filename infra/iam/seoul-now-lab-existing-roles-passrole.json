{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PassExistingClusterAndManagedNodeRolesToEks",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::963701985499:role/seoul-now-lab-eks-cluster-role",
        "arn:aws:iam::963701985499:role/seoul-now-lab-eks-node-role"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "eks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "PassExistingCniRoleToEksPodIdentity",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::963701985499:role/seoul-now-lab-eks-cni-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "pods.eks.amazonaws.com"
        }
      }
    }
  ]
}
