# Local Docker Compose settings. Defaults also work without a .env file.
API_PORT=8000
DB_PORT=5432

# Containers connect to the Compose service name "db", not localhost.
APP_DATABASE_URL=postgresql+psycopg://seoul:seoul_local@db:5432/seoul_now
# JSON arrays are required for list settings.
APP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
APP_DOCS_ENABLED=true
APP_DB_CONNECT_TIMEOUT_SECONDS=3
APP_HEALTH_TIMEOUT_SECONDS=5

# GetParkInfo collection only. Never commit your actual key.
# [연결됨] 서울 공영주차장 GetParkInfo / 서울 열린데이터광장 인증키
# https://data.seoul.go.kr/dataList/OA-13122/A/1/datasetView.do
APP_SEOUL_API_KEY=
# OA-21285 서울 실시간 도시데이터. 실제 키는 로컬 .env에만 입력한다.
# [연결됨] 도시데이터: 인구·도로·주차 등 / 서울 열린데이터광장 인증키
# https://data.seoul.go.kr/dataList/OA-21285/A/1/datasetView.do
APP_SEOUL_CITYDATA_API_KEY=

# 공공데이터포털 인증키 (서비스 확인 후 연동)
# [추가 연동 예정] 한국교통안전공단 주차정보 활용신청 후 발급받은 인증키
# https://www.data.go.kr/data/15099883/openapi.do
APP_DATA_GO_KR_API_KEY=

# 서울시 시영주차장 실시간 주차대수 정보 (OA-21709)
# [연결됨] 시영주차장 실시간 주차 현황 / 서울 열린데이터광장 인증키
# https://data.seoul.go.kr/dataList/OA-21709/S/1/datasetView.do
APP_SEOUL_MUNICIPAL_PARKING_API_KEY=

# TOPIS 도로소통용 서울시 키 (비워두면 기존 서울시 키 사용)
# [연결됨] TOPIS 도로 소통 / 서울 열린데이터광장 인증키
# https://data.seoul.go.kr/dataList/OA-13291/A/1/datasetView.do
APP_SEOUL_TOPIS_API_KEY=

# Kakao REST API key (server only)
# [검색·길찾기 연결됨] 카카오 앱의 REST API 키. JavaScript 키와 다름.
# 행정동 좌표 조회는 추가 구현 필요. 프론트 JavaScript 키는 프론트 .env.local에 유지.
# https://developers.kakao.com/
APP_KAKAO_REST_API_KEY=
# ===== 추가 연결용 입력칸: 키를 넣는 것만으로 수집이 시작되지는 않습니다 =====
# [미구현] S-DoT 10분 통행량 / 서울 열린데이터광장 인증키
# 같은 서울시 일반 인증키라도 이 서비스의 접근 권한은 확인해야 합니다.
# https://data.seoul.go.kr/dataList/OA-22832/S/1/datasetView.do
APP_SEOUL_SDOT_API_KEY=

# [미구현] ITS 도로 CCTV / ITS에서 발급한 인증키
# https://www.its.go.kr/opendata/opendataList?service=cctv
APP_ITS_API_KEY=

# [미구현] SGIS 행정동 목록·경계 / 개발지원센터 서비스 등록 후 발급한 ID와 Secret
# 토큰은 이 두 값으로 서버에서 발급받도록 구현할 예정입니다.
# https://sgis.mods.go.kr/developer/html/openApi/api/data.html
APP_SGIS_CONSUMER_KEY=
APP_SGIS_CONSUMER_SECRET=

# ===== 파일 자료: 아래 자료는 API 키 입력칸이 필요하지 않습니다 =====
# 전국주차장표준데이터: 서울 자료 다운로드·적재 (현재 미구현)
# https://www.data.go.kr/data/15012896/standard.do
# 서울 전체 경계: 다운로드·좌표변환·서울 소재지 필터 (현재 미구현)
# https://data.seoul.go.kr/dataList/OA-22162/S/1/datasetView.do
# 121장소 관측 경계: 공식 안내에서 파일 확보 후 장소 코드와 연결 (현재 미구현)
# https://data.seoul.go.kr/dataVisual/seoul/guide.do
